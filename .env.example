# Frontend settings (used by Vite; safe to expose in the built desktop app)
VITE_AZURE_FUNCTION_URL=https://<function-app-name>.azurewebsites.net/api/sync
VITE_AZURE_FUNCTION_KEY=<function-key>

# Azure Functions runtime settings
# Keep these in the Azure Function App configuration, not in source control.
COSMOS_DB_CONNECTION_STRING=<cosmos-db-connection-string>
COSMOS_DB_DATABASE=PasswordVaultDB
AzureWebJobsStorage=<azure-storage-connection-string>
